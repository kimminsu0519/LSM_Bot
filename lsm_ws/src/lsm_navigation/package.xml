<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lsm_navigation</name>
  <version>0.0.1</version>
  <description>ROS 2 Navigation2 Bringup and Waypoints configuration for LSM Bot</description>
  <maintainer email="kms@todo.todo">kms</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_dwb_controller</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>lsm_bot_description</exec_depend>
  <exec_depend>lsm_interfaces</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
