<?xml version="1.0"?>
<robot name="mir200_amr">
  <!-- Base Footprint -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- Base Link (Industrial Rectangular AMR Chassis) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.9 0.6 0.24"/>
      </geometry>
      <material name="yellow_black">
        <color rgba="0.95 0.75 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.9 0.6 0.24"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="60.0"/>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <inertia ixx="2.0" ixy="0.0" ixz="0.0" iyy="4.5" iyz="0.0" izz="5.5"/>
    </inertial>
  </link>

  <!-- Top Payload Deck -->
  <joint name="deck_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_deck"/>
    <origin xyz="0 0 0.24" rpy="0 0 0"/>
  </joint>

  <link name="top_deck">
    <visual>
      <geometry>
        <box size="0.88 0.58 0.02"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Left Wheel -->
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0 0.31 0" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_left_link">
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.015"/>
    </inertial>
  </link>

  <!-- Right Wheel -->
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0 -0.31 0" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_right_link">
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.015"/>
    </inertial>
  </link>

  <!-- Front LiDAR Sensor -->
  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="0.4 0 0.2" rpy="0 0 0"/>
  </joint>

  <link name="base_scan">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Gazebo Sim Material Tags for OGRE2 Render Engine -->
  <gazebo reference="base_link">
    <material>
      <ambient>0.95 0.75 0.1 1.0</ambient>
      <diffuse>0.95 0.75 0.1 1.0</diffuse>
    </material>
  </gazebo>

  <gazebo reference="top_deck">
    <material>
      <ambient>0.2 0.2 0.2 1.0</ambient>
      <diffuse>0.2 0.2 0.2 1.0</diffuse>
    </material>
  </gazebo>

  <gazebo reference="wheel_left_link">
    <material>
      <ambient>0.05 0.05 0.05 1.0</ambient>
      <diffuse>0.05 0.05 0.05 1.0</diffuse>
    </material>
  </gazebo>

  <gazebo reference="wheel_right_link">
    <material>
      <ambient>0.05 0.05 0.05 1.0</ambient>
      <diffuse>0.05 0.05 0.05 1.0</diffuse>
    </material>
  </gazebo>

  <gazebo reference="base_scan">
    <material>
      <ambient>0.1 0.3 0.9 1.0</ambient>
      <diffuse>0.1 0.3 0.9 1.0</diffuse>
    </material>
  </gazebo>

  <!-- Gazebo Sim Sensors & Diff Drive Plugin -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.62</wheel_separation>
      <wheel_radius>0.1</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

  <gazebo reference="base_scan">
    <sensor type="gpu_lidar" name="front_lidar">
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <frame_id>base_scan</frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

</robot>
