<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="lsm_custom_warehouse">
    
    <!-- GUI Camera Default View & Grid Configuration (0.6m Cell Length, 80 Count) -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>-21.0 -10.0 5.0 0 0.5 1.57</pose>
      </camera>
    </gui>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>true</shadows>
      <grid>
        <cell_length>0.6</cell_length>
        <cell_count>80</cell_count>
        <normal>0 0 1</normal>
        <pose>0 0 0.015 0 0 0</pose>
      </grid>
    </scene>

    <!-- Physics engine settings -->
    <physics default="0" name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000.0</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8</gravity>

    <!-- Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 25 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================================== -->
    <!-- WAREHOUSE OUTER BOUNDARY WALLS (외벽 두께 0.3m가 내부 영역을 침범하지 않도록 외곽 이동) -->
    <!-- 내부 공간: 가로 46.8m x 세로 10.8m x 높이 2.5m -->
