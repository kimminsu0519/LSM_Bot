<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="lsm_custom_warehouse">
    
    <!-- Scene settings (Disable default 1.0m world grid) -->
    <scene>
      <grid>false</grid>
    </scene>

    <!-- GUI Camera Default View focused on Charging Pad (-21.0, -5.1) -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>-21.0 -10.0 5.0 0 0.5 1.57</pose>
      </camera>
    </gui>

    <!-- Physics engine settings -->
    <physics default="0" name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000.0</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8</gravity>

    <!-- Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 25 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane (무한 바닥) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 60</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 60</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.6 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================================== -->
    <!-- WAREHOUSE INDUSTRIAL EPOXY FLOOR (창고 내부 46.8m x 10.8m 전용 에폭시 바닥) -->
